# Скопируйте в /etc/skat.env (права 600) и впишите СВОИ ключи. Этот файл с ключами в git попадать не должен.
# Общий секрет колонки и сервера: openssl rand -hex 24
SKAT_TOKEN=

# Yandex Cloud: API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user и ai.speechkit-tts.user, и ID каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Мозг по умолчанию (быстрый и дешёвый)
DEEPSEEK_API_KEY=

# Необязательно: ChatGPT, голос OpenAI, рисование на монитор, живой разговор
OPENAI_API_KEY=

# Необязательно: настройки
#SKAT_VOICE=ermil
#SKAT_TZ=Europe/Moscow
#SKAT_PERSONA=Тебя зовут Скат ... (свой характер вместо встроенного)
#OPENAI_MODEL=gpt-4.1
#OPENAI_VOICE=onyx
#OPENAI_RT_MODEL=gpt-realtime-2.1-mini
#OPENAI_RT_VOICE=cedar
